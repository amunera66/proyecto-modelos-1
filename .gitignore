# ===== Entorno virtual =====
.venv/
venv/
env/
ENV/

# ===== Bytecode / cache de Python =====
__pycache__/
*.py[cod]
*$py.class
*.so
*.pyd

# ===== Notebooks =====
.ipynb_checkpoints/
*/.ipynb_checkpoints/*
profile_default/
ipython_config.py

# ===== Datos grandes =====
# Los datasets NO van al repo: se descargan con kaggle o con un script.
data/*.csv
data/*.tsv
data/*.parquet
data/*.xlsx
data/*.xls
data/*.json
data/*.zip
data/*.gz
data/*.7z
data/*.db
data/*.sqlite
data/raw/
data/interim/
data/processed/
data/external/
# ...pero si conserva la estructura de carpetas y los README
!data/**/.gitkeep
!data/**/README.md
# Carpeta local con el paquete completo de Kaggle (7 CSV, ~940 MB)
dataset/

# ===== Modelos entrenados / artefactos =====
*.pkl
*.joblib
*.h5
*.onnx
models/
artifacts/
# Excepcion: el modelo de la Fase 1 es un entregable y si se versiona
!fase-1/models/
!fase-1/models/*.joblib

# ===== Credenciales =====
# La API key de Kaggle NUNCA se sube
kaggle.json
.env
.env.*
*.pem
*.key

# ===== Testing / cobertura =====
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
.mypy_cache/
.ruff_cache/

# ===== Empaquetado =====
build/
dist/
*.egg-info/
*.egg
.eggs/

# ===== Editores =====
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/
*.swp

# ===== Windows / macOS =====
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
.DS_Store

# ===== Logs =====
*.log
logs/

# ===== Archivos locales del equipo =====
# Configuracion local del asistente de codigo
.claude/
# Grafico de prueba que genera verificar_entorno.py
_verificacion_grafico.png
# Parches de trabajo que se comparten fuera del repo
*.patch
